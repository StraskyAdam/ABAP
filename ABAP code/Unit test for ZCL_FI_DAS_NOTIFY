CLASS lcl_notify_mailer DEFINITION.
  PUBLIC SECTION.
    INTERFACES zif_fi_das_email.
    DATA template TYPE string.
    DATA language TYPE string.
    DATA active TYPE abap_bool.
    DATA recipients TYPE zif_fi_das_email=>tt_recipients.
    DATA params TYPE zif_fi_das_email=>tt_params.
    DATA subject_params TYPE zif_fi_das_email=>tt_params.
    DATA replace_all TYPE abap_bool.
    DATA attachments TYPE zif_fi_das_email=>tt_attachments.
ENDCLASS.

CLASS lcl_notify_mailer IMPLEMENTATION.
  METHOD zif_fi_das_email~get_language.
    r_language = 'DE'.
  ENDMETHOD.
  METHOD zif_fi_das_email~send.
    template = i_template.
    language = i_language.
    active = i_require_active.
    recipients = it_recipients.
    params = it_params.
    subject_params = it_subject_params.
    replace_all = i_replace_all.
    attachments = it_attachments.
  ENDMETHOD.
ENDCLASS.

CLASS lcl_notify_fake DEFINITION INHERITING FROM zcl_fi_das_notify.
  PUBLIC SECTION.
    DATA rows TYPE zif_fi_das_dashboard=>tt_notify_row.
    DATA events TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA sent TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA attachments TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA fail_recipient TYPE i.
    DATA fail_text TYPE abap_bool.
    DATA use_real_send TYPE abap_bool.
    DATA use_real_text TYPE abap_bool.
    DATA mailer TYPE REF TO lcl_notify_mailer.
    DATA now TYPE timestampl VALUE '20261127100000'.
    METHODS csv
      IMPORTING i_date TYPE d it_rows TYPE zif_fi_das_dashboard=>tt_notify_row
      RETURNING VALUE(r_csv) TYPE string.
    METHODS recipients
      IMPORTING it_rows TYPE zif_fi_das_dashboard=>tt_notify_row
      RETURNING VALUE(rt_emails) TYPE tt_string.
    METHODS language
      IMPORTING i_email TYPE string
      RETURNING VALUE(r_language) TYPE string
      RAISING cx_static_check.
    METHODS translation
      IMPORTING i_id TYPE string i_language TYPE string
      RETURNING VALUE(r_text) TYPE string
      RAISING cx_static_check.
  PROTECTED SECTION.
    METHODS get_rows REDEFINITION.
    METHODS get_now REDEFINITION.
    METHODS save_audit REDEFINITION.
    METHODS commit_work REDEFINITION.
    METHODS get_language REDEFINITION.
    METHODS get_mailer REDEFINITION.
    METHODS get_name REDEFINITION.
    METHODS get_link REDEFINITION.
    METHODS get_text REDEFINITION.
    METHODS send_email REDEFINITION.
ENDCLASS.

CLASS lcl_notify_fake IMPLEMENTATION.
  METHOD get_rows.
    rt_rows = rows.
  ENDMETHOD.
  METHOD get_now.
    r_now = now.
  ENDMETHOD.
  METHOD save_audit.
    APPEND `audit` TO events.
    super->save_audit( it_audit ).
  ENDMETHOD.
  METHOD commit_work.
    APPEND `commit` TO events.
  ENDMETHOD.
  METHOD get_language.
    IF use_real_send = abap_true.
      r_language = super->get_language( i_email ).
    ELSE.
      r_language = 'EN'.
    ENDIF.
  ENDMETHOD.
  METHOD get_mailer.
    ro_mailer = mailer.
  ENDMETHOD.
  METHOD get_name.
    r_name = |Name:{ i_email }|.
  ENDMETHOD.
  METHOD get_link.
    r_link = 'https://example.com/das'.
  ENDMETHOD.
  METHOD get_text.
    IF use_real_text = abap_true.
      r_text = super->get_text( i_id = i_id i_language = i_language ).
      RETURN.
    ENDIF.
    APPEND |text:{ i_id }| TO events.
    IF fail_text = abap_true.
      RAISE EXCEPTION TYPE zcx_fi_das_error
        EXPORTING i_text = 'Missing translation'.
    ENDIF.
    r_text = i_id.
  ENDMETHOD.
  METHOD send_email.
    APPEND |send:{ i_email }| TO events.
    IF fail_recipient > 0 AND lines( sent ) + 1 = fail_recipient.
      RAISE EXCEPTION TYPE zcx_fi_das_error
        EXPORTING i_text = 'Mail failed'.
    ENDIF.
    IF use_real_send = abap_true.
      super->send_email( i_email = i_email i_user = i_user i_date = i_date it_rows = it_rows ).
    ENDIF.
    APPEND i_email TO sent.
    APPEND build_csv( i_date = i_date it_rows = it_rows ) TO attachments.
  ENDMETHOD.
  METHOD csv.
    r_csv = build_csv( i_date = i_date it_rows = it_rows ).
  ENDMETHOD.
  METHOD recipients.
    rt_emails = get_recipients( it_rows ).
  ENDMETHOD.
  METHOD language.
    use_real_send = abap_true.
    r_language = get_language( i_email ).
  ENDMETHOD.
  METHOD translation.
    use_real_text = abap_true.
    r_text = get_text( i_id = i_id i_language = i_language ).
  ENDMETHOD.
ENDCLASS.

CLASS ltc_notify DEFINITION FINAL FOR TESTING
  DURATION SHORT RISK LEVEL HARMLESS.
  PRIVATE SECTION.
    DATA mo_env TYPE REF TO if_osql_test_environment.
    DATA mo_cut TYPE REF TO lcl_notify_fake.
    DATA mt_items TYPE zif_fi_das_dashboard=>tt_notify_item.
    METHODS setup.
    METHODS teardown.
    METHODS same_owner_preparer FOR TESTING RAISING cx_static_check.
    METHODS recipient_subset FOR TESTING RAISING cx_static_check.
    METHODS audit_before_mail FOR TESTING RAISING cx_static_check.
    METHODS bounded_audit FOR TESTING RAISING cx_static_check.
    METHODS exactly_24_hours FOR TESTING RAISING cx_static_check.
    METHODS future_audit FOR TESTING RAISING cx_static_check.
    METHODS old_audit FOR TESTING RAISING cx_static_check.
    METHODS fractional_boundary FOR TESTING RAISING cx_static_check.
    METHODS future_and_recent FOR TESTING RAISING cx_static_check.
    METHODS missing_email FOR TESTING RAISING cx_static_check.
    METHODS mail_failure FOR TESTING RAISING cx_static_check.
    METHODS translation_failure FOR TESTING RAISING cx_static_check.
    METHODS result_order FOR TESTING RAISING cx_static_check.
    METHODS csv_contract FOR TESTING.
    METHODS template_contract FOR TESTING RAISING cx_static_check.
    METHODS language_missing_vs_blank FOR TESTING RAISING cx_static_check.
    METHODS exact_translation FOR TESTING RAISING cx_static_check.
    METHODS december_rollover FOR TESTING RAISING cx_static_check.
    METHODS invalid_and_duplicate FOR TESTING.
    METHODS source_lookup_quirk FOR TESTING.
    METHODS empty_input FOR TESTING.
    METHODS long_audit_email FOR TESTING.
    METHODS add_audit IMPORTING i_changedon TYPE timestampl
                                        i_flag TYPE c DEFAULT space.
    METHODS run RETURNING VALUE(r_message) TYPE string
                RAISING cx_static_check.
ENDCLASS.

CLASS ltc_notify IMPLEMENTATION.
  METHOD setup.
    mo_env = cl_osql_test_environment=>create(
      i_dependency_list = VALUE #(
        ( 'ZFI_DAS_PO_AUDIT' ) ( 'ZFI_DAS_USR_LANG' ) ( 'ZFI_DAS_TEXT_TR' ) ) ).
    mo_cut = NEW #( ).
    mo_cut->mailer = NEW #( ).
    mt_items = VALUE #( ( ponumber = '8000130083' itemno = '00001' ) ).
    mo_cut->rows = VALUE #( (
      ponumber = '8000130083' itemno = '00001' companycode = '3317'
      poowner_email = 'owner@example.com' po_preparer = 'owner@example.com' ) ).
  ENDMETHOD.

  METHOD teardown.
    mo_env->destroy( ).
  ENDMETHOD.

  METHOD run.
    r_message = mo_cut->execute( i_user = 'notifier@example.com' it_items = mt_items ).
  ENDMETHOD.

  METHOD add_audit.
    DATA lt_audit TYPE STANDARD TABLE OF zfi_das_po_audit WITH EMPTY KEY.
    lt_audit = VALUE #( (
      mandt = sy-mandt ponumber = '8000130083' lineitem = '00001'
      changedon = i_changedon flag = i_flag ) ).
    mo_env->insert_test_data( lt_audit ).
  ENDMETHOD.

  METHOD same_owner_preparer.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 1 ).
    cl_abap_unit_assert=>assert_equals(
      act = l_message
      exp = |8000130083 - 00001 - owner@example.com - NOTIFY_SENT\n| ).
    SELECT * FROM zfi_das_po_audit INTO TABLE @DATA(lt_audit).
    cl_abap_unit_assert=>assert_equals( act = lines( lt_audit ) exp = 1 ).
    cl_abap_unit_assert=>assert_equals(
      act = lt_audit[ 1 ]-po_notifiedby exp = 'notifier@example.com' ).
    cl_abap_unit_assert=>assert_initial( lt_audit[ 1 ]-changedby ).
    cl_abap_unit_assert=>assert_equals( act = lt_audit[ 1 ]-flag exp = abap_true ).
  ENDMETHOD.

  METHOD recipient_subset.
    mo_cut->rows[ 1 ]-po_preparer = 'preparer@example.com'.
    APPEND VALUE #(
      ponumber = '8000130083' itemno = '00002' companycode = '3317'
      poowner_email = 'other@example.com' po_preparer = 'preparer@example.com'
    ) TO mo_cut->rows.
    APPEND VALUE #( ponumber = '8000130083' itemno = '00002' ) TO mt_items.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 3 ).
    cl_abap_unit_assert=>assert_equals( act = mo_cut->sent[ 2 ] exp = 'preparer@example.com' ).
    cl_abap_unit_assert=>assert_true(
      xsdbool( mo_cut->attachments[ 2 ] CS `"00001"` AND
               mo_cut->attachments[ 2 ] CS `"00002"` ) ).
    cl_abap_unit_assert=>assert_false( xsdbool( mo_cut->attachments[ 1 ] CS `"00002"` ) ).
  ENDMETHOD.

  METHOD audit_before_mail.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = mo_cut->events[ 1 ] exp = 'audit' ).
    cl_abap_unit_assert=>assert_equals( act = mo_cut->events[ 2 ] exp = 'commit' ).
    cl_abap_unit_assert=>assert_equals( act = mo_cut->events[ 3 ] exp = 'text:NOTIFY_NO_EMAIL' ).
    cl_abap_unit_assert=>assert_equals(
      act = mo_cut->events[ lines( mo_cut->events ) ] exp = 'commit' ).
  ENDMETHOD.

  METHOD bounded_audit.
    add_audit( i_changedon = '20261126100000.0000001' i_flag = space ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_initial( mo_cut->sent ).
    cl_abap_unit_assert=>assert_equals(
      act = l_message exp = |8000130083 - 00001 - NOTIFIED_24\n| ).
    cl_abap_unit_assert=>assert_equals( act = mo_cut->events[ 1 ] exp = 'commit' ).
  ENDMETHOD.

  METHOD exactly_24_hours.
    add_audit( '20261126100000' ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_initial( mo_cut->sent ).
    cl_abap_unit_assert=>assert_true( xsdbool( l_message CS 'NOTIFIED_24' ) ).
  ENDMETHOD.

  METHOD future_audit.
    add_audit( '20261127100000.0000001' ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 1 ).
  ENDMETHOD.

  METHOD old_audit.
    add_audit( '20261126095959.9999999' ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 1 ).
  ENDMETHOD.

  METHOD fractional_boundary.
    mo_cut->now = '20261127100000.5000000'.
    add_audit( '20261126100000.4999999' ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 1 ).
  ENDMETHOD.

  METHOD future_and_recent.
    add_audit( '20261127100000.0000001' ).
    add_audit( '20261127090000' ).
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_initial( mo_cut->sent ).
    cl_abap_unit_assert=>assert_true( xsdbool( l_message CS 'NOTIFIED_24' ) ).
  ENDMETHOD.

  METHOD missing_email.
    CLEAR: mo_cut->rows[ 1 ]-poowner_email, mo_cut->rows[ 1 ]-po_preparer.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals(
      act = l_message exp = |8000130083 - 00001 - NOTIFY_NO_EMAIL\n| ).
    cl_abap_unit_assert=>assert_initial( mo_cut->sent ).
    SELECT COUNT( * ) FROM zfi_das_po_audit INTO @DATA(l_count).
    cl_abap_unit_assert=>assert_equals( act = l_count exp = 0 ).
  ENDMETHOD.

  METHOD mail_failure.
    mo_cut->rows[ 1 ]-po_preparer = 'preparer@example.com'.
    mo_cut->fail_recipient = 2.
    TRY.
        DATA(l_message) = run( ).
        cl_abap_unit_assert=>fail( 'Expected mail failure' ).
      CATCH zcx_fi_das_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_equals( act = lx_error->get_text( ) exp = 'Mail failed' ).
    ENDTRY.
    cl_abap_unit_assert=>assert_equals( act = lines( mo_cut->sent ) exp = 1 ).
    SELECT COUNT( * ) FROM zfi_das_po_audit INTO @DATA(l_count).
    cl_abap_unit_assert=>assert_equals( act = l_count exp = 1 ).
    DATA(l_last) = lines( mo_cut->events ).
    cl_abap_unit_assert=>assert_equals(
      act = mo_cut->events[ l_last - 1 ] exp = 'commit' ).
  ENDMETHOD.

  METHOD translation_failure.
    mo_cut->fail_text = abap_true.
    TRY.
        DATA(l_message) = run( ).
        cl_abap_unit_assert=>fail( 'Expected translation failure' ).
      CATCH zcx_fi_das_error.
        cl_abap_unit_assert=>assert_equals( act = mo_cut->events[ 2 ] exp = 'commit' ).
    ENDTRY.
    SELECT COUNT( * ) FROM zfi_das_po_audit INTO @DATA(l_count).
    cl_abap_unit_assert=>assert_equals( act = l_count exp = 1 ).
    cl_abap_unit_assert=>assert_initial( mo_cut->sent ).
  ENDMETHOD.

  METHOD result_order.
    add_audit( '20261127090000' ).
    APPEND VALUE #( ponumber = '8000130083' itemno = '00002' ) TO mo_cut->rows.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_equals(
      act = l_message
      exp = |8000130083 - 00002 - NOTIFY_NO_EMAIL\n8000130083 - 00001 - NOTIFIED_24\n| ).
  ENDMETHOD.

  METHOD csv_contract.
    DATA(l_csv) = mo_cut->csv( i_date = '20261130' it_rows = mo_cut->rows ).
    cl_abap_unit_assert=>assert_equals(
      act = l_csv
      exp = |"sep=\|"\nPurchase Order Number\|Item Number\|Posting Date\|Company Code\|\n| &&
            |"8000130083"\|"00001"\|"30 Nov 2026"\|"3317"\|\n| ).
  ENDMETHOD.

  METHOD december_rollover.
    mo_cut->now = '20261231235959'.
    DATA(l_message) = run( ).
    cl_abap_unit_assert=>assert_true(
      xsdbool( mo_cut->attachments[ 1 ] CS `"31 Dec 2026"` ) ).
  ENDMETHOD.

  METHOD template_contract.
    DATA lt_languages TYPE STANDARD TABLE OF zfi_das_usr_lang WITH EMPTY KEY.
    lt_languages = VALUE #( ( mandt = sy-mandt email_id = 'owner@example.com' language = 'DE' ) ).
    mo_env->insert_test_data( lt_languages ).
    mo_cut->use_real_send = abap_true.
    DATA(l_message) = run( ).
    DATA(lo_mailer) = mo_cut->mailer.
    cl_abap_unit_assert=>assert_equals( act = lo_mailer->template exp = 'REVIEW_PO' ).
    cl_abap_unit_assert=>assert_equals( act = lo_mailer->language exp = 'DE' ).
    cl_abap_unit_assert=>assert_equals( act = lo_mailer->active exp = abap_true ).
    cl_abap_unit_assert=>assert_equals( act = lines( lo_mailer->recipients ) exp = 1 ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->recipients[ 1 ]-kind exp = zif_fi_das_email=>mc_to ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->params[ name = 'POOWNER' ]-value exp = 'Name:owner@example.com' ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->params[ name = 'USER' ]-value exp = 'Name:notifier@example.com' ).
    cl_abap_unit_assert=>assert_equals( act = lo_mailer->params[ name = 'MONTH' ]-value exp = 'November' ).
    cl_abap_unit_assert=>assert_equals( act = lo_mailer->subject_params[ name = 'YEAR' ]-value exp = '2026' ).
    cl_abap_unit_assert=>assert_false( lo_mailer->replace_all ).
    cl_abap_unit_assert=>assert_false( xsdbool( line_exists( lo_mailer->params[ name = 'YEAR' ] ) ) ).
    cl_abap_unit_assert=>assert_false( xsdbool( line_exists( lo_mailer->subject_params[ name = 'USER' ] ) ) ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->params[ name = 'LINK' ]-value exp = 'https://example.com/das' ).
    cl_abap_unit_assert=>assert_equals( act = lines( lo_mailer->attachments ) exp = 1 ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->attachments[ 1 ]-name exp = 'OpenPOs.csv' ).
    DATA(lo_converter) = cl_abap_conv_out_ce=>create( encoding = '4103' ).
    lo_converter->write( data = mo_cut->attachments[ 1 ] ).
    cl_abap_unit_assert=>assert_equals(
      act = lo_mailer->attachments[ 1 ]-content exp = lo_converter->get_buffer( ) ).
  ENDMETHOD.

  METHOD invalid_and_duplicate.
    mo_cut->rows[ 1 ]-po_preparer = 'invalid'.
    APPEND mo_cut->rows[ 1 ] TO mo_cut->rows.
    DATA(lt_emails) = mo_cut->recipients( mo_cut->rows ).
    cl_abap_unit_assert=>assert_equals( act = lines( lt_emails ) exp = 1 ).
    cl_abap_unit_assert=>assert_equals( act = lt_emails[ 1 ] exp = 'owner@example.com' ).
  ENDMETHOD.

  METHOD language_missing_vs_blank.
    cl_abap_unit_assert=>assert_equals(
      act = mo_cut->language( 'absent@example.com' ) exp = 'EN' ).
    DATA lt_languages TYPE STANDARD TABLE OF zfi_das_usr_lang WITH EMPTY KEY.
    lt_languages = VALUE #( ( mandt = sy-mandt email_id = 'blank@example.com' language = '' ) ).
    mo_env->insert_test_data( lt_languages ).
    cl_abap_unit_assert=>assert_initial( mo_cut->language( 'blank@example.com' ) ).
  ENDMETHOD.

  METHOD exact_translation.
    DATA lt_texts TYPE STANDARD TABLE OF zfi_das_text_tr WITH EMPTY KEY.
    lt_texts = VALUE #( (
      mandt = sy-mandt text_id = 'NOTIFY_SENT' language = 'EN'
      text_translations = `Mail Sent ` ) ).
    mo_env->insert_test_data( lt_texts ).
    cl_abap_unit_assert=>assert_equals(
      act = mo_cut->translation( i_id = 'NOTIFY_SENT' i_language = 'EN' )
      exp = `Mail Sent ` ).
    TRY.
        mo_cut->translation( i_id = 'NOTIFY_SENT' i_language = 'DE' ).
        cl_abap_unit_assert=>fail( 'Missing language must not fall back to EN' ).
      CATCH zcx_fi_das_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_true( xsdbool( lx_error->get_text( ) CS 'NOTIFY_SENT/DE' ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD source_lookup_quirk.
    mo_cut->rows = VALUE #(
      ( poowner_email = 'one@example.com' po_preparer = 'two@example.com' )
      ( poowner_email = 'two@example.com' po_preparer = 'one@example.com' )
      ( poowner_email = 'two@example.com' po_preparer = 'one@example.com' ) ).
    DATA(lt_emails) = mo_cut->recipients( mo_cut->rows ).
    cl_abap_unit_assert=>assert_equals( act = lines( lt_emails ) exp = 2 ).
    cl_abap_unit_assert=>assert_equals( act = lt_emails[ 1 ] exp = 'one@example.com' ).
    cl_abap_unit_assert=>assert_equals( act = lt_emails[ 2 ] exp = 'two@example.com' ).
  ENDMETHOD.

  METHOD empty_input.
    TRY.
        mo_cut->execute( i_user = 'notifier@example.com' it_items = VALUE #( ) ).
        cl_abap_unit_assert=>fail( 'Expected input validation error' ).
      CATCH zcx_fi_das_error.
        cl_abap_unit_assert=>assert_initial( mo_cut->events ).
      CATCH cx_sy_open_sql_db.
        cl_abap_unit_assert=>fail( 'SQL must not run for empty input' ).
    ENDTRY.
  ENDMETHOD.

  METHOD long_audit_email.
    mo_cut->rows[ 1 ]-poowner_email = repeat( val = 'a' occ = 226 ).
    TRY.
        mo_cut->execute( i_user = 'notifier@example.com' it_items = mt_items ).
        cl_abap_unit_assert=>fail( 'Expected audit truncation guard' ).
      CATCH zcx_fi_das_error.
        cl_abap_unit_assert=>assert_initial( mo_cut->events ).
      CATCH cx_sy_open_sql_db.
        cl_abap_unit_assert=>fail( 'SQL insert must not run for an oversized email' ).
    ENDTRY.
  ENDMETHOD.
ENDCLASS.
