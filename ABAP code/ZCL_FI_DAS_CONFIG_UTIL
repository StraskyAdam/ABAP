    CONSTANTS mc_record_already_exists TYPE symsgno VALUE '001' ##NO_TEXT.
    CONSTANTS mc_configuration_not_created TYPE symsgno VALUE '002' ##NO_TEXT.
    CONSTANTS mc_configuration_not_deleted TYPE symsgno VALUE '003' ##NO_TEXT.
    CONSTANTS mc_configuration_not_updated TYPE symsgno VALUE '004' ##NO_TEXT.
ENDCLASS.



CLASS ZCL_FI_DAS_CONFIG_UTIL IMPLEMENTATION.


  METHOD country_exists.

    SELECT SINGLE @abap_true
      FROM zfi_das_country
    WHERE country_code = @is_country-country_code AND
          country_name = @is_country-country_name AND
          bukrs = @is_country-bukrs
      INTO @r_exists.

    IF sy-subrc <> 0.
      CLEAR r_exists.
    ENDIF.

  ENDMETHOD.


  METHOD create_config_value.

    MODIFY zfi_das_conf_val FROM @is_conf_val.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_country.

    IF country_exists( is_country ) = abap_true.
      raise_exception( mc_record_already_exists ).
    ENDIF.

    INSERT zfi_das_country FROM @is_country.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_created ).
    ENDIF.

  ENDMETHOD.


  METHOD create_email_template.

    MODIFY zfi_das_email FROM @is_email_tmpl.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_help_link.

    MODIFY zfi_das_helplink FROM @is_helplink.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_language.

    MODIFY zfi_das_lang FROM @is_lang.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_threshold.

    MODIFY zfi_das_thresh FROM @is_threshold.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_userrole.

    MODIFY zfi_das_roles FROM @is_role.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD create_video_link.

    MODIFY zfi_das_videolnk FROM @is_video_link.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_config_value.

    DELETE FROM zfi_das_conf_val
      WHERE config_name = @is_conf_val-config_name.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_country.

    DELETE FROM zfi_das_country
      WHERE country_code = @is_country-country_code AND
            country_name = @is_country-country_name AND
            bukrs = @is_country-bukrs.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_email_template.

    DELETE FROM zfi_das_email
      WHERE template_name = @is_email_tmpl-template_name AND
            language      = @is_email_tmpl-language.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_help_link.

    DELETE FROM zfi_das_helplink
      WHERE role = @is_helplink-role AND
            help_id = @is_helplink-help_id AND
            language = @is_helplink-language.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_language.

    DELETE FROM zfi_das_lang
      WHERE lang_code = @is_lang-lang_code.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_threshold.

    DELETE FROM zfi_das_thresh
      WHERE currency = @is_threshold-currency AND
            company_code = @is_threshold-company_code.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_userrole.

    DELETE FROM zfi_das_roles
      WHERE user_emailid = @is_role-user_emailid AND
            company_code = @is_role-company_code.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD delete_video_link.

    DELETE FROM zfi_das_videolnk
      WHERE role     = @is_video_link-role AND
            video_id = @is_video_link-video_id AND
            language = @is_video_link-language.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_deleted ).
    ENDIF.

  ENDMETHOD.


  METHOD get_config_values.

    SELECT config_name, config_value
      FROM zfi_das_conf_val
    INTO CORRESPONDING FIELDS OF TABLE @rt_conf_val.

    IF sy-subrc <> 0.
      CLEAR rt_conf_val.
    ENDIF.

  ENDMETHOD.


  METHOD get_countries.

    SELECT country_code, country_name, bukrs
      FROM zfi_das_country
    INTO CORRESPONDING FIELDS OF TABLE @rt_country.

    IF sy-subrc <> 0.
      CLEAR rt_country.
    ENDIF.

  ENDMETHOD.


  METHOD get_email_templates.

    SELECT template_name, language, subject, body, status
      FROM zfi_das_email
    INTO CORRESPONDING FIELDS OF TABLE @rt_email_tmpl.

    IF sy-subrc <> 0.
      CLEAR rt_email_tmpl.
    ENDIF.

  ENDMETHOD.


METHOD get_help_links.

  IF i_language IS SUPPLIED.

    DATA(lr_language) = VALUE tr_language( ( sign   = rsmds_c_sign-including
                                             option = rsmds_c_option-equal
                                             low    = i_language ) ).
  ENDIF.

  SELECT role, help_id, language, help_desc, help_link
    FROM zfi_das_helplink
  WHERE language IN @lr_language
    INTO CORRESPONDING FIELDS OF TABLE @rt_helplink.

  IF sy-subrc <> 0.
    CLEAR rt_helplink.
  ENDIF.

ENDMETHOD.


  METHOD get_languages.

    SELECT lang_code, language
      FROM zfi_das_lang
    INTO CORRESPONDING FIELDS OF TABLE @rt_lang.

    IF sy-subrc <> 0.
      CLEAR rt_lang.
    ENDIF.

  ENDMETHOD.


  METHOD get_thresholds.

    SELECT currency, company_code, po_threshold
      FROM zfi_das_thresh
    INTO CORRESPONDING FIELDS OF TABLE @rt_threshold.

    IF sy-subrc <> 0.
      CLEAR rt_threshold.
    ENDIF.

  ENDMETHOD.


  METHOD get_userroles.

    SELECT user_emailid, company_code, user_role, user_access, management_unit,cost_center
      FROM zfi_das_roles
    INTO CORRESPONDING FIELDS OF TABLE @rt_roles.

    IF sy-subrc <> 0.
      CLEAR rt_roles.
    ENDIF.

  ENDMETHOD.


METHOD get_video_links.

  IF i_language IS SUPPLIED.

    DATA(lr_language) = VALUE tr_language( ( sign   = rsmds_c_sign-including
                                             option = rsmds_c_option-equal
                                             low    = i_language ) ).
  ENDIF.

  SELECT role, video_id, language, video_desc, video_link
    FROM zfi_das_videolnk
  WHERE language IN @lr_language
    INTO CORRESPONDING FIELDS OF TABLE @rt_video_link.

  IF sy-subrc <> 0.
    CLEAR rt_video_link.
  ENDIF.

ENDMETHOD.


  METHOD raise_exception.

    DATA(lo_msg_container) = /iwbep/cl_mgw_msg_container=>get_mgw_msg_container( ).

    lo_msg_container->add_message( iv_msg_type = i_msg_type
                                   iv_msg_id = i_msg_id
                                   iv_msg_number = i_msg_number ).

    RAISE EXCEPTION TYPE /iwbep/cx_mgw_busi_exception
      EXPORTING
        message_container = lo_msg_container.

  ENDMETHOD.


  METHOD update_threshold.

    MODIFY zfi_das_thresh FROM @is_threshold.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.


  METHOD update_userrole.

    MODIFY zfi_das_roles FROM @is_role.

    IF sy-subrc <> 0.
      raise_exception( mc_configuration_not_updated ).
    ENDIF.

  ENDMETHOD.
ENDCLASS.
