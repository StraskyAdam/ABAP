CLASS zcl_fi_das_csv DEFINITION PUBLIC FINAL CREATE PRIVATE.
  PUBLIC SECTION.
    TYPES tt_strings TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    TYPES t_separator TYPE c LENGTH 1.

    CLASS-METHODS format_row
      IMPORTING
        it_values             TYPE tt_strings
        i_separator           TYPE t_separator DEFAULT ','
        i_empty_value         TYPE string OPTIONAL
        i_trailing_separator  TYPE abap_bool DEFAULT abap_false
      RETURNING
        VALUE(r_row)          TYPE string.

    CLASS-METHODS join_lines
      IMPORTING
        it_lines              TYPE tt_strings
        i_line_separator      TYPE string DEFAULT cl_abap_char_utilities=>cr_lf
        i_final_line_separator TYPE abap_bool DEFAULT abap_true
      RETURNING
        VALUE(r_text)         TYPE string.

    CLASS-METHODS encode_utf8
      IMPORTING
        i_text           TYPE string
        i_bom            TYPE abap_bool DEFAULT abap_false
      RETURNING
        VALUE(r_content) TYPE xstring
      RAISING
        cx_sy_codepage_converter_init
        cx_sy_conversion_codepage.
ENDCLASS.

CLASS zcl_fi_das_csv IMPLEMENTATION.
  METHOD format_row.
    DATA lt_cells TYPE tt_strings.

    LOOP AT it_values INTO DATA(l_value).
      IF l_value IS INITIAL.
        l_value = i_empty_value.
      ENDIF.
      REPLACE ALL OCCURRENCES OF '"' IN l_value WITH '""'.
      APPEND |"{ l_value }"| TO lt_cells.
    ENDLOOP.

    r_row = concat_lines_of( table = lt_cells sep = i_separator ).
    IF i_trailing_separator = abap_true AND it_values IS NOT INITIAL.
      r_row = r_row && i_separator.
    ENDIF.
  ENDMETHOD.

  METHOD join_lines.
    r_text = concat_lines_of( table = it_lines sep = i_line_separator ).
    IF i_final_line_separator = abap_true AND it_lines IS NOT INITIAL.
      r_text = r_text && i_line_separator.
    ENDIF.
  ENDMETHOD.

  METHOD encode_utf8.
    CONSTANTS lc_utf8_bom TYPE x LENGTH 3 VALUE 'EFBBBF'.
    DATA(lo_converter) = cl_abap_conv_out_ce=>create( encoding = 'UTF-8' ).
    lo_converter->write( data = i_text ).
    r_content = lo_converter->get_buffer( ).
    IF i_bom = abap_true.
      DATA(l_utf8) = r_content.
      CONCATENATE lc_utf8_bom l_utf8 INTO r_content IN BYTE MODE.
    ENDIF.
  ENDMETHOD.
ENDCLASS.
