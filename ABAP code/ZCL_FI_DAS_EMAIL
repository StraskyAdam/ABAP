CLASS zcl_fi_das_email DEFINITION PUBLIC CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES zif_fi_das_email.



  PROTECTED SECTION.

    CONSTANTS mc_max_attachment_name_length TYPE i VALUE 50.

    TYPES:
      BEGIN OF ts_template,
        subject TYPE string,
        body    TYPE string,
        status  TYPE string,
      END OF ts_template.

    METHODS get_template_data
      IMPORTING i_template         TYPE string
                i_language         TYPE string
      RETURNING VALUE(rs_template) TYPE ts_template
      RAISING   zcx_fi_das_error.
    METHODS read_sender
      RETURNING VALUE(r_sender) TYPE string
      RAISING   zcx_fi_das_error.
    METHODS read_language
      IMPORTING i_email    TYPE string
      EXPORTING e_found    TYPE abap_bool
                e_language TYPE string
      RAISING   zcx_fi_das_error.
    METHODS dispatch
      IMPORTING
                i_sender       TYPE string
                i_subject      TYPE string
                i_body         TYPE string
                it_recipients  TYPE zif_fi_das_email=>tt_recipients
                it_attachments TYPE zif_fi_das_email=>tt_attachments
      RETURNING VALUE(r_sent)  TYPE abap_bool
      RAISING   zcx_fi_das_error.

  PRIVATE SECTION.
    METHODS get_content_for_template
      IMPORTING i_template         TYPE string
                i_language         TYPE string
                i_require_active   TYPE abap_bool
      RETURNING VALUE(rs_template) TYPE ts_template
      RAISING   zcx_fi_das_error.
    CLASS-METHODS replace_placeholders
      IMPORTING
                i_text        TYPE string
                it_params     TYPE zif_fi_das_email=>tt_params
      RETURNING VALUE(r_text) TYPE string.
ENDCLASS.

CLASS zcl_fi_das_email IMPLEMENTATION.

  METHOD zif_fi_das_email~send.

    LOOP AT it_recipients ASSIGNING FIELD-SYMBOL(<fs_recipient>).

      IF <fs_recipient>-kind <> zif_fi_das_email=>mc_to AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_cc AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_bcc.

        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e040(zfi_das).

      ENDIF.
    ENDLOOP.

    LOOP AT it_attachments ASSIGNING FIELD-SYMBOL(<fs_attachment>).

      IF strlen( <fs_attachment>-name ) > mc_max_attachment_name_length.
        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e041(zfi_das).
      ENDIF.

    ENDLOOP.

    DATA(ls_template) = get_content_for_template(
      i_template = i_template
      i_language = i_language
      i_require_active = i_require_active ).

    DATA(l_subject) = replace_placeholders( i_text = ls_template-subject it_params = it_params ).

    DATA(l_body) = replace_placeholders( i_text = ls_template-body it_params = it_params ).

    DATA(l_sender) = read_sender( ).

    IF dispatch( i_sender = l_sender i_subject = l_subject i_body = l_body
                 it_recipients = it_recipients it_attachments = it_attachments ) <> abap_true.
      RAISE EXCEPTION TYPE zcx_fi_das_error
        EXPORTING
          i_text = 'BCS did not accept the request for all recipients; caller must resolve its LUW'.
    ENDIF.
  ENDMETHOD.

  METHOD get_content_for_template.
    rs_template = get_template_data( i_template = i_template i_language = i_language ).
    IF i_require_active = abap_true AND rs_template-status <> abap_true.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e043(zfi_das).
    ENDIF.
  ENDMETHOD.

  METHOD get_template_data.

    SELECT SINGLE subject, body, status
       FROM zfi_das_email
    WHERE template_name = @i_template AND
          language = @i_language
       INTO @rs_template.

    IF sy-subrc <> 0.
       RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e042(zfi_das).
    ENDIF.

  ENDMETHOD.




  METHOD replace_placeholders.
    DATA lt_params TYPE SORTED TABLE OF zif_fi_das_email=>ts_param
                   WITH UNIQUE KEY name.
    LOOP AT it_params INTO DATA(ls_param).
      INSERT ls_param INTO TABLE lt_params.
    ENDLOOP.

    TYPES:
      BEGIN OF ts_replacement,
        offset TYPE i,
        length TYPE i,
        value  TYPE string,
      END OF ts_replacement.
    DATA lt_replacements TYPE STANDARD TABLE OF ts_replacement WITH EMPTY KEY.
    DATA lt_matches TYPE match_result_tab.
    LOOP AT lt_params INTO ls_param.
      DATA(l_token) = |&{ ls_param-name }&|.
      CLEAR lt_matches.
      FIND ALL OCCURRENCES OF l_token IN i_text RESULTS lt_matches.
      LOOP AT lt_matches INTO DATA(ls_match).
        APPEND VALUE #( offset = ls_match-offset length = ls_match-length
                        value = ls_param-value ) TO lt_replacements.
      ENDLOOP.
    ENDLOOP.
    SORT lt_replacements BY offset.
    DATA l_position TYPE i VALUE 0.
    LOOP AT lt_replacements INTO DATA(ls_replacement).
      IF ls_replacement-offset < l_position.
        CONTINUE.
      ENDIF.
      DATA(l_length) = ls_replacement-offset - l_position.
      r_text = r_text && substring( val = i_text off = l_position len = l_length ).
      r_text = r_text && ls_replacement-value.
      l_position = ls_replacement-offset + ls_replacement-length.
    ENDLOOP.
    r_text = r_text && substring( val = i_text off = l_position ).
  ENDMETHOD.

  METHOD zif_fi_das_email~get_language.
    read_language( EXPORTING i_email = i_email
                   IMPORTING e_found = DATA(l_found) e_language = DATA(l_language) ).
    IF l_found = abap_false.
      l_language = 'EN'.
    ENDIF.
    r_language = l_language.
  ENDMETHOD.





  METHOD read_sender.
    TRY.
        SELECT SINGLE config_value FROM zfi_das_conf_val
          WHERE config_name = 'EMAIL_FROM' INTO @r_sender.
        IF sy-subrc <> 0 OR r_sender IS INITIAL.
          RAISE EXCEPTION TYPE zcx_fi_das_error
            EXPORTING
              i_text = 'EMAIL_FROM configuration is missing or empty'.
        ENDIF.
      CATCH cx_sy_open_sql_db INTO DATA(lx_sql).
        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_sql
            i_text   = 'EMAIL_FROM read failed'.
    ENDTRY.
  ENDMETHOD.

  METHOD read_language.
    CLEAR: e_found, e_language.
    TRY.
        SELECT SINGLE language FROM zfi_das_usr_lang
          WHERE email_id = @i_email INTO @e_language.
        e_found = xsdbool( sy-subrc = 0 ).
      CATCH cx_sy_open_sql_db INTO DATA(lx_sql).
        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_sql
            i_text   = 'User language read failed'.
    ENDTRY.
  ENDMETHOD.

  METHOD dispatch.
    DATA lt_header TYPE soli_tab.
    DATA l_header TYPE soli.
    DATA l_short_subject TYPE so_obj_des VALUE 'DAS email'.
    DATA l_attachment_size TYPE so_obj_len.
    DATA l_address TYPE adr6-smtp_addr.

    DATA(lt_body) = cl_bcs_convert=>string_to_soli( iv_string = i_body ).
    TRY.
        DATA(lo_request) = cl_bcs=>create_persistent( ).
        DATA(lo_document) = cl_document_bcs=>create_document(
          i_type = 'RAW' i_subject = l_short_subject
          i_text = lt_body ).
        LOOP AT it_attachments INTO DATA(ls_attachment).
          CLEAR lt_header.
          l_header-line = |&SO_FILENAME={ ls_attachment-name }|.
          APPEND l_header TO lt_header.
          l_attachment_size = xstrlen( ls_attachment-content ).
          lo_document->add_attachment(
            i_attachment_type = ls_attachment-document_type
            i_attachment_subject = CONV so_obj_des( ls_attachment-name )
            i_attachment_size = l_attachment_size
            i_attachment_header = lt_header
            i_att_content_hex = cl_bcs_convert=>xstring_to_solix(
              iv_xstring = ls_attachment-content ) ).
        ENDLOOP.
        lo_request->set_document( lo_document ).
        lo_request->set_message_subject( ip_subject = i_subject ).
        l_address = i_sender.
        lo_request->set_sender( cl_cam_address_bcs=>create_internet_address( l_address ) ).
        LOOP AT it_recipients INTO DATA(ls_recipient).
          l_address = ls_recipient-email.
          lo_request->add_recipient(
            i_recipient = cl_cam_address_bcs=>create_internet_address( l_address )
            i_copy = xsdbool( ls_recipient-kind = zif_fi_das_email=>mc_cc )
            i_blind_copy = xsdbool( ls_recipient-kind = zif_fi_das_email=>mc_bcc ) ).
        ENDLOOP.
        r_sent = lo_request->send( i_with_error_screen = abap_false ).
      CATCH cx_bcs INTO DATA(lx_bcs).
        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_bcs
            i_text   = 'BCS email request failed; caller must resolve its LUW'.
    ENDTRY.
  ENDMETHOD.
ENDCLASS.
