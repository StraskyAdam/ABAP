CLASS zcl_fi_das_email DEFINITION PUBLIC CREATE PUBLIC.
  PUBLIC SECTION.
    INTERFACES zif_fi_das_email.



  PROTECTED SECTION.

    CONSTANTS mc_max_attachment_name_length TYPE i VALUE 50.
    CONSTANTS mc_placeholder_delimiter TYPE c LENGTH 1 VALUE '&'.
    CONSTANTS mc_config_email_from TYPE zfi_das_conf_val-config_name   VALUE 'EMAIL_FROM'.

    TYPES:
      BEGIN OF ts_template,
        subject TYPE string,
        body    TYPE string,
        status  TYPE string,
      END OF ts_template.

    METHODS get_template_data
      IMPORTING i_template         TYPE string
                i_language         TYPE string
      RETURNING VALUE(rs_template) TYPE ts_template
      RAISING   zcx_fi_das_error.
    METHODS get_sender
      RETURNING VALUE(r_sender) TYPE string
      RAISING   zcx_fi_das_error.
    METHODS read_language
      IMPORTING i_email    TYPE string
      EXPORTING e_found    TYPE abap_bool
                e_language TYPE string
      RAISING   zcx_fi_das_error.
    METHODS send_email
      IMPORTING
                i_sender       TYPE string
                i_subject      TYPE string
                i_body         TYPE string
                it_recipients  TYPE zif_fi_das_email=>tt_recipients
                it_attachments TYPE zif_fi_das_email=>tt_attachments
      RAISING   zcx_fi_das_error.

  PRIVATE SECTION.
    CONSTANTS mc_document_type_raw TYPE so_obj_tp VALUE 'RAW'.
    CONSTANTS mc_default_subject TYPE so_obj_des VALUE 'DAS email'.

    METHODS add_attachments
      IMPORTING io_document    TYPE REF TO cl_document_bcs
                it_attachments TYPE zif_fi_das_email=>tt_attachments
      RAISING   cx_bcs.
    METHODS add_recipients
      IMPORTING io_request    TYPE REF TO cl_bcs
                it_recipients TYPE zif_fi_das_email=>tt_recipients
      RAISING   cx_bcs.
    METHODS get_content_for_template
      IMPORTING i_template         TYPE string
                i_language         TYPE string
                i_require_active   TYPE abap_bool
      RETURNING VALUE(rs_template) TYPE ts_template
      RAISING   zcx_fi_das_error.
    CLASS-METHODS replace_placeholders
      IMPORTING
                i_text        TYPE string
                it_params     TYPE zif_fi_das_email=>tt_params
      RETURNING VALUE(r_text) TYPE string.
ENDCLASS.

CLASS zcl_fi_das_email IMPLEMENTATION.

  METHOD zif_fi_das_email~send.

    LOOP AT it_recipients ASSIGNING FIELD-SYMBOL(<fs_recipient>).

      IF <fs_recipient>-kind <> zif_fi_das_email=>mc_to AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_cc AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_bcc.
        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e040(zfi_das).
      ENDIF.

    ENDLOOP.

    LOOP AT it_attachments ASSIGNING FIELD-SYMBOL(<fs_attachment>).

      IF strlen( <fs_attachment>-name ) > mc_max_attachment_name_length.
        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e041(zfi_das).
      ENDIF.

    ENDLOOP.

    DATA(ls_template) = get_content_for_template( i_template       = i_template
                                                  i_language       = i_language
                                                  i_require_active = i_require_active ).

    send_email(
      i_sender = get_sender( )
      i_subject = replace_placeholders( i_text = ls_template-subject it_params = it_params )
      i_body = replace_placeholders( i_text = ls_template-body it_params = it_params )
      it_recipients = it_recipients
      it_attachments = it_attachments ).
  ENDMETHOD.

  METHOD get_content_for_template.

    rs_template = get_template_data( i_template = i_template
                                     i_language = i_language ).

    IF i_require_active = abap_true AND rs_template-status <> abap_true.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e043(zfi_das).
    ENDIF.

  ENDMETHOD.

  METHOD get_template_data.

    SELECT SINGLE subject, body, status
       FROM zfi_das_email
    WHERE template_name = @i_template AND
          language = @i_language
       INTO @rs_template.

    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e042(zfi_das).
    ENDIF.

  ENDMETHOD.

  METHOD replace_placeholders.

    r_text = i_text.

    LOOP AT it_params ASSIGNING FIELD-SYMBOL(<fs_param>).

      REPLACE ALL OCCURRENCES OF |{ mc_placeholder_delimiter }{ <fs_param>-name }{ mc_placeholder_delimiter }|
        IN r_text
      WITH <fs_param>-value.

    ENDLOOP.

  ENDMETHOD.

  METHOD get_sender.

    SELECT SINGLE config_value
      FROM zfi_das_conf_val
    WHERE config_name = @mc_config_email_from
      INTO @r_sender.

    IF sy-subrc <> 0 OR r_sender IS INITIAL.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e044(zfi_das).
    ENDIF.

  ENDMETHOD.

  METHOD send_email.
    DATA(lt_body) = cl_bcs_convert=>string_to_soli( iv_string = i_body ).

    TRY.
        DATA(lo_request) = cl_bcs=>create_persistent( ).
        DATA(lo_document) = cl_document_bcs=>create_document(
          i_type = mc_document_type_raw i_subject = mc_default_subject
          i_text = lt_body ).
        add_attachments( io_document = lo_document it_attachments = it_attachments ).
        lo_request->set_document( lo_document ).
        lo_request->set_message_subject( ip_subject = i_subject ).
        lo_request->set_sender( cl_cam_address_bcs=>create_internet_address(
          CONV adr6-smtp_addr( i_sender ) ) ).
        add_recipients( io_request = lo_request it_recipients = it_recipients ).
        IF lo_request->send( i_with_error_screen = abap_false ) <> abap_true.
          RAISE EXCEPTION TYPE zcx_fi_das_error
            EXPORTING
              i_text = 'BCS did not accept the request for all recipients; caller must resolve its LUW'.
        ENDIF.
      CATCH cx_bcs INTO DATA(lx_bcs).
        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_bcs
            i_text   = 'BCS email request failed; caller must resolve its LUW'.
    ENDTRY.
  ENDMETHOD.

  METHOD add_attachments.
    LOOP AT it_attachments ASSIGNING FIELD-SYMBOL(<fs_attachment>).
      DATA(lt_header) = VALUE soli_tab(
        ( line = |&SO_FILENAME={ <fs_attachment>-name }| ) ).
      io_document->add_attachment(
        i_attachment_type = <fs_attachment>-document_type
        i_attachment_subject = CONV so_obj_des( <fs_attachment>-name )
        i_attachment_size = CONV so_obj_len( xstrlen( <fs_attachment>-content ) )
        i_attachment_header = lt_header
        i_att_content_hex = cl_bcs_convert=>xstring_to_solix(
          iv_xstring = <fs_attachment>-content ) ).
    ENDLOOP.
  ENDMETHOD.

  METHOD add_recipients.
    LOOP AT it_recipients ASSIGNING FIELD-SYMBOL(<fs_recipient>).
      io_request->add_recipient(
        i_recipient = cl_cam_address_bcs=>create_internet_address(
          CONV adr6-smtp_addr( <fs_recipient>-email ) )
        i_copy = xsdbool( <fs_recipient>-kind = zif_fi_das_email=>mc_cc )
        i_blind_copy = xsdbool( <fs_recipient>-kind = zif_fi_das_email=>mc_bcc ) ).
    ENDLOOP.
  ENDMETHOD.

*******************************************

  METHOD zif_fi_das_email~get_language.
    read_language( EXPORTING i_email = i_email
                   IMPORTING e_found = DATA(l_found) e_language = DATA(l_language) ).
    IF l_found = abap_false.
      l_language = 'EN'.
    ENDIF.
    r_language = l_language.
  ENDMETHOD.







  METHOD read_language.
    CLEAR: e_found, e_language.
    TRY.
        SELECT SINGLE language FROM zfi_das_usr_lang
          WHERE email_id = @i_email INTO @e_language.
        e_found = xsdbool( sy-subrc = 0 ).
      CATCH cx_sy_open_sql_db INTO DATA(lx_sql).
        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_sql
            i_text   = 'User language read failed'.
    ENDTRY.
  ENDMETHOD.


ENDCLASS.
