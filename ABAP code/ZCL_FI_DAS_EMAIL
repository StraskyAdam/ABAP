CLASS zcl_fi_das_email DEFINITION PUBLIC CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES zif_fi_das_email.

  PROTECTED SECTION.

    CONSTANTS: mc_max_attachment_name_length TYPE i VALUE 50,
               mc_placeholder_marker         TYPE c LENGTH 1 VALUE '&',
               mc_config_email_from          TYPE zfi_das_conf_val-config_name VALUE 'EMAIL_FROM',
               mc_attachment_header_prefix   TYPE string VALUE '&SO_FILENAME=',
               mc_default_language           TYPE c LENGTH 2 VALUE 'EN',
               mc_sender_name                TYPE string VALUE 'Accrual application',
               mc_body_line_length           TYPE i VALUE 255,
               mc_document_type_raw          TYPE so_obj_tp VALUE 'RAW',
               mc_document_subject           TYPE so_obj_des VALUE 'DAS'.

    TYPES: BEGIN OF ts_template,
             subject TYPE string,
             body    TYPE string,
             status  TYPE string,
           END OF ts_template.

    METHODS get_template
      IMPORTING
        i_template         TYPE string
        i_language         TYPE string
      RETURNING
        VALUE(rs_template) TYPE ts_template
      RAISING
        zcx_fi_das_error.

    METHODS get_sender
      RETURNING
        VALUE(r_sender) TYPE string
      RAISING
        zcx_fi_das_error.

    METHODS get_body_lines
      IMPORTING
        i_body          TYPE string
      RETURNING
        VALUE(rt_lines) TYPE soli_tab.

    METHODS send_email
      IMPORTING
        i_sender       TYPE string
        i_subject      TYPE string
        i_body         TYPE string
        it_recipients  TYPE zif_fi_das_email=>tt_recipients
        it_attachments TYPE zif_fi_das_email=>tt_attachments
      RAISING
        zcx_fi_das_error.

  PRIVATE SECTION.

    METHODS add_attachments
      IMPORTING
        io_document    TYPE REF TO cl_document_bcs
        it_attachments TYPE zif_fi_das_email=>tt_attachments
      RAISING
        zcx_fi_das_error
        cx_bcs.

    METHODS add_recipients
      IMPORTING
        io_request    TYPE REF TO cl_bcs
        it_recipients TYPE zif_fi_das_email=>tt_recipients
      RAISING
        zcx_fi_das_error
        cx_bcs.

    CLASS-METHODS replace_placeholders
      IMPORTING
        i_text        TYPE string
        it_params     TYPE zif_fi_das_email=>tt_params
      RETURNING
        VALUE(r_text) TYPE string.

ENDCLASS.

CLASS ZCL_FI_DAS_EMAIL IMPLEMENTATION.

  METHOD add_attachments.

    LOOP AT it_attachments ASSIGNING FIELD-SYMBOL(<fs_attachment>).

      IF strlen( <fs_attachment>-name ) > mc_max_attachment_name_length.
        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e041(zfi_das).
      ENDIF.

      DATA(lt_header) = VALUE soli_tab( ( line = |{ mc_attachment_header_prefix }{ <fs_attachment>-name }| ) ).

      io_document->add_attachment( i_attachment_type = <fs_attachment>-document_type
                                   i_attachment_subject = CONV so_obj_des( <fs_attachment>-name )
                                   i_attachment_size = CONV so_obj_len( xstrlen( <fs_attachment>-content ) )
                                   i_attachment_header = lt_header
                                   i_att_content_hex = cl_bcs_convert=>xstring_to_solix( iv_xstring = <fs_attachment>-content ) ).
    ENDLOOP.

  ENDMETHOD.

  METHOD add_recipients.

    LOOP AT it_recipients ASSIGNING FIELD-SYMBOL(<fs_recipient>).

      IF <fs_recipient>-kind <> zif_fi_das_email=>mc_to AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_cc AND
         <fs_recipient>-kind <> zif_fi_das_email=>mc_bcc.
         RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e040(zfi_das).
      ENDIF.

      io_request->add_recipient( i_recipient = cl_cam_address_bcs=>create_internet_address( CONV adr6-smtp_addr( <fs_recipient>-email ) )
                                 i_copy = xsdbool( <fs_recipient>-kind = zif_fi_das_email=>mc_cc )
                                 i_blind_copy = xsdbool( <fs_recipient>-kind = zif_fi_das_email=>mc_bcc ) ).
    ENDLOOP.

  ENDMETHOD.

  METHOD get_sender.

    SELECT SINGLE config_value
      FROM zfi_das_conf_val
    WHERE config_name = @mc_config_email_from
      INTO @r_sender.

    IF sy-subrc <> 0 OR r_sender IS INITIAL.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e044(zfi_das).
    ENDIF.

  ENDMETHOD.

  METHOD get_template.

    SELECT SINGLE subject, body, status
       FROM zfi_das_email
    WHERE template_name = @i_template AND
          language = @i_language
       INTO @rs_template.

    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e042(zfi_das).
    ENDIF.

  ENDMETHOD.

  METHOD replace_placeholders.

    r_text = i_text.

    LOOP AT it_params ASSIGNING FIELD-SYMBOL(<fs_param>).

      REPLACE ALL OCCURRENCES OF |{ mc_placeholder_marker }{ <fs_param>-name }{ mc_placeholder_marker }|
        IN r_text
      WITH <fs_param>-value.

    ENDLOOP.

  ENDMETHOD.

  METHOD send_email.

    DATA(lt_body) = get_body_lines( i_body ).

    TRY.
        DATA(lo_request) = cl_bcs=>create_persistent( ).

        DATA(lo_document) = cl_document_bcs=>create_document( i_subject = mc_document_subject
                                                              i_type = mc_document_type_raw
                                                              i_text = lt_body ).

        add_attachments( io_document = lo_document it_attachments = it_attachments ).

        lo_request->set_document( lo_document ).

        lo_request->set_message_subject( i_subject ).

        lo_request->set_sender(
          cl_cam_address_bcs=>create_internet_address(
            i_address_string = CONV adr6-smtp_addr( i_sender )
            i_address_name   = mc_sender_name ) ).

        add_recipients( io_request = lo_request
                        it_recipients = it_recipients ).

        IF lo_request->send( i_with_error_screen = abap_false ) <> abap_true.
          RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e045(zfi_das).
        ENDIF.

      CATCH cx_bcs INTO DATA(lx_bcs).
        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e046(zfi_das)
          EXPORTING
            previous = lx_bcs.
    ENDTRY.

  ENDMETHOD.

  METHOD get_body_lines.

    DATA lt_lines TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA(l_body) = i_body.

    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf IN l_body
      WITH cl_abap_char_utilities=>newline.
    SPLIT l_body AT cl_abap_char_utilities=>newline INTO TABLE lt_lines.

    LOOP AT lt_lines INTO DATA(l_line).
      WHILE strlen( l_line ) > mc_body_line_length.
        APPEND VALUE #( line = substring( val = l_line len = mc_body_line_length ) ) TO rt_lines.
        l_line = substring( val = l_line off = mc_body_line_length ).
      ENDWHILE.

      APPEND VALUE #( line = l_line ) TO rt_lines.
    ENDLOOP.

  ENDMETHOD.

  METHOD zif_fi_das_email~get_language.

    SELECT SINGLE language
      FROM zfi_das_usr_lang
    WHERE email_id = @i_email
      INTO @r_language.

    IF r_language IS INITIAL.
      r_language = mc_default_language.
    ENDIF.

  ENDMETHOD.

  METHOD zif_fi_das_email~send.

    DATA(ls_template) = get_template( i_template = i_template
                                      i_language = i_language ).

    IF i_require_active = abap_true AND ls_template-status <> abap_true.
      RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e043(zfi_das).
    ENDIF.

    send_email( i_sender = get_sender( )
                i_subject = replace_placeholders( i_text = ls_template-subject it_params = it_params )
                i_body = replace_placeholders( i_text = ls_template-body it_params = it_params )
                it_recipients = it_recipients
                it_attachments = it_attachments ).

  ENDMETHOD.

ENDCLASS.
