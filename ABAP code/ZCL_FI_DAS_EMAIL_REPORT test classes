CLASS ltc_fi_das_email_report DEFINITION DEFERRED.
CLASS zcl_fi_das_email_report DEFINITION LOCAL FRIENDS ltc_fi_das_email_report.

CLASS ltc_fi_das_email_report DEFINITION FINAL FOR TESTING
  DURATION SHORT
  RISK LEVEL HARMLESS.

  PRIVATE SECTION.
    DATA mo_cut TYPE REF TO zcl_fi_das_email_report.

    METHODS setup.
    METHODS header_row_column_count FOR TESTING.
    METHODS description_normalizes_en_dash FOR TESTING.
    METHODS numeric_values_use_raw_decimal FOR TESTING.
    METHODS date_uses_xsa_format FOR TESTING.
ENDCLASS.

CLASS ltc_fi_das_email_report IMPLEMENTATION.
  METHOD setup.
    mo_cut = NEW #( ).
  ENDMETHOD.

  METHOD header_row_column_count.
    DATA(l_header) = mo_cut->get_csv_header( ).
    DATA lt_headers TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    SPLIT l_header AT ',' INTO TABLE lt_headers.
    DELETE lt_headers WHERE table_line IS INITIAL.

    DATA(l_row) = mo_cut->get_csv_row( VALUE #( ) ).
    DATA lt_cells TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    SPLIT l_row AT ',' INTO TABLE lt_cells.
    DELETE lt_cells WHERE table_line IS INITIAL.

    cl_abap_unit_assert=>assert_equals( act = lines( lt_headers ) exp = 44 ).
    cl_abap_unit_assert=>assert_equals( act = lines( lt_cells ) exp = lines( lt_headers ) ).
    cl_abap_unit_assert=>assert_true( act = xsdbool( l_header CP '*,' ) ).
    cl_abap_unit_assert=>assert_true( act = xsdbool( l_row CP '*,' ) ).
  ENDMETHOD.

  METHOD description_normalizes_en_dash.
    DATA(ls_row) = VALUE zcl_fi_das_email_report=>ts_report_row(
      polinedesc = |A, "B" – C| ).
    DATA(l_row) = mo_cut->get_csv_row( ls_row ).

    cl_abap_unit_assert=>assert_true(
      act = xsdbool( l_row CS |"A, ""B"" - C"| ) ).
  ENDMETHOD.

  METHOD numeric_values_use_raw_decimal.
    DATA(ls_row) = VALUE zcl_fi_das_email_report=>ts_report_row(
      povalue = '1234.50' ).
    DATA(l_row) = mo_cut->get_csv_row( ls_row ).

    cl_abap_unit_assert=>assert_true(
      act = xsdbool( l_row CS ',"1234.50",' ) ).
  ENDMETHOD.

  METHOD date_uses_xsa_format.
    cl_abap_unit_assert=>assert_equals(
      act = mo_cut->format_date( '20240305' )
      exp = '05 Mar 2024' ).
  ENDMETHOD.

ENDCLASS.
