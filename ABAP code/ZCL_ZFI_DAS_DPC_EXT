  constants MC_PARAMETER_EMAIL type STRING value 'IP_EMAIL' ##NO_TEXT.
  constants MC_PARAMETER_PSTYPE type STRING value 'IP_PSTYPE' ##NO_TEXT.
  constants MC_PARAMETER_POOWNER type STRING value 'IP_POOWNER' ##NO_TEXT.
  constants MC_PARAMETER_POVALUE type STRING value 'IV_POVALUE' ##NO_TEXT.
  constants MC_PARAMETER_POCURRENCY type STRING value 'IV_POCURRENCY' ##NO_TEXT.
  constants MC_PARAMETER_WRKSTRTDATE type STRING value 'IV_WRKSTRTDATE' ##NO_TEXT.
  constants MC_PARAMETER_WRKENDDATE type STRING value 'IV_WRKENDDATE' ##NO_TEXT.
  constants MC_PARAMETER_ACCRUALMETHOD type STRING value 'IV_ACCRUALMETHOD' ##NO_TEXT.
  constants MC_PARAMETER_TOTWRKCOMPAMT type STRING value 'IV_TOTWRKCOMPAMT' ##NO_TEXT.
  constants MC_PARAMETER_TOTWRKCOMPPER type STRING value 'IV_TOTWRKCOMPPER' ##NO_TEXT.
  constants MC_PARAMETER_EDGEWTDAMT type STRING value 'IV_EDGEWTDAMT' ##NO_TEXT.
  constants MC_PARAMETER_PSTYP type STRING value 'IV_PSTYP' ##NO_TEXT.
  constants MC_PARAMETER_COMPANY type STRING value 'IV_COMPANY' ##NO_TEXT.
  constants MC_PARAMETER_PONUM type STRING value 'IP_PONUM' ##NO_TEXT.
  constants MC_PARAMETER_LINEITEM type STRING value 'IP_LINEITEM' ##NO_TEXT.
