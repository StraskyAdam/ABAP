CLASS ZCL_ZFI_DAS_DPC_EXT IMPLEMENTATION.


  METHOD audit_get_entityset.

    IF io_tech_request_context IS NOT BOUND.
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception.
    ENDIF.

    TRY.

        get_dashboard( )->audit(
          EXPORTING
            is_request = VALUE #(
              parameter = get_audit_parameter( it_key_tab )
              orderby   = get_orderby( io_tech_request_context )
              paging    = get_paging( io_tech_request_context ) )
          IMPORTING
            et_result = et_entityset ).

      CATCH cx_sy_itab_line_not_found
            cx_sy_conversion_error
            cx_sy_open_sql_db
            zcx_fi_das_error INTO DATA(lx_error).

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.


  METHOD build_request.

    IF io_tech_request_context IS NOT BOUND.
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception.
    ENDIF.

    rs_request = VALUE #( parameter = get_parameter( it_key_tab )
                          paging = get_paging( io_tech_request_context )
                          filter = get_filter( io_tech_request_context )
                          orderby = get_orderby( io_tech_request_context ) ).

  ENDMETHOD.


  METHOD exclusionposet_get_entityset.

    TRY.
        get_dashboard( )->exclude(
          EXPORTING
            is_request    = build_request( it_key_tab              = it_key_tab
                                           io_tech_request_context = io_tech_request_context )
          IMPORTING
            et_result     = et_entityset
            e_total_count = es_response_context-inlinecount ).

      CATCH cx_sy_conversion_error
            cx_sy_open_sql_db
            zcx_fi_das_error INTO DATA(lx_error).

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.


  METHOD get_audit_parameter.

    rs_parameter-ip_ponum = it_key_tab[ name = mc_parameter_ponum ]-value.

    rs_parameter-ip_lineitem = it_key_tab[ name = mc_parameter_lineitem ]-value.

  ENDMETHOD.


  METHOD get_dashboard.

    ro_dashboard = NEW zcl_fi_das_dashboard( ).

  ENDMETHOD.


  METHOD get_filter.

    TRY.
        DATA(lo_filter) = io_tech_request_context->get_filter( ).

        IF lo_filter IS NOT BOUND.
          RETURN.
        ENDIF.

        rs_filter-filter_select_options = VALUE #( FOR ls_filter IN lo_filter->get_filter_select_options( )
                                                     FOR ls_option IN ls_filter-select_options (
                                                       property = to_upper( ls_filter-property )
                                                       sign = ls_option-sign
                                                       option = ls_option-option
                                                       low = ls_option-low
                                                       high = ls_option-high ) ).

        rs_filter-filter_string = lo_filter->get_filter_string( ).

*       Raise an exception to avoid processing an unsupported filter
        IF rs_filter-filter_string IS INITIAL AND io_tech_request_context->get_filter_expression_tree( ) IS BOUND.
          RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception.
        ENDIF.

      CATCH cx_root INTO DATA(lx_error).

        CLEAR rs_filter.

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.


  METHOD get_method_parameter.

    TRY.

        rs_parameter-iv_povalue = EXACT #( CONV decfloat34( it_key_tab[ name = mc_parameter_povalue ]-value ) ).

        rs_parameter-iv_pocurrency = it_key_tab[ name = mc_parameter_pocurrency ]-value.

        rs_parameter-iv_wrkstrtdate = zcl_fi_das_utility=>parse_iso_date( it_key_tab[ name = mc_parameter_wrkstrtdate ]-value ).

        rs_parameter-iv_wrkenddate = zcl_fi_das_utility=>parse_iso_date( it_key_tab[ name = mc_parameter_wrkenddate ]-value ).

        rs_parameter-iv_accrualmethod = it_key_tab[ name = mc_parameter_accrualmethod ]-value.

        rs_parameter-iv_totwrkcompamt = it_key_tab[ name = mc_parameter_totwrkcompamt ]-value.

        rs_parameter-iv_totwrkcompper = EXACT #( CONV decfloat34( it_key_tab[ name = mc_parameter_totwrkcompper ]-value ) ).

        rs_parameter-iv_edgewtdamt = EXACT #( CONV decfloat34( it_key_tab[ name = mc_parameter_edgewtdamt ]-value ) ).

        rs_parameter-iv_pstyp = it_key_tab[ name = mc_parameter_pstyp ]-value.

        rs_parameter-iv_company = it_key_tab[ name = mc_parameter_company ]-value.

      CATCH cx_sy_itab_line_not_found INTO DATA(lx_missing).

        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e034(zfi_das)
          EXPORTING
            previous = lx_missing.

    ENDTRY.

  ENDMETHOD.


  METHOD get_orderby.

    LOOP AT io_tech_request_context->get_orderby( ) ASSIGNING FIELD-SYMBOL(<fs_orderby>) WHERE property IS NOT INITIAL.

      APPEND VALUE #( property   = to_upper( CONV string( <fs_orderby>-property ) )
                      descending = xsdbool( to_upper( <fs_orderby>-order ) = mc_order_descending ) ) TO rs_orderby.

    ENDLOOP.

  ENDMETHOD.


  METHOD get_paging.

    DATA(l_top) = io_tech_request_context->get_top( ).

    rs_paging-top_requested = xsdbool( l_top IS NOT INITIAL ).

    rs_paging-top = l_top.

    rs_paging-skip = io_tech_request_context->get_skip( ).

    rs_paging-count_requested = io_tech_request_context->has_inlinecount( ).

  ENDMETHOD.


  METHOD get_parameter.

    rs_parameter-email = VALUE #( it_key_tab[ name = mc_parameter_email ]-value OPTIONAL ).

    rs_parameter-pstype = VALUE #( it_key_tab[ name = mc_parameter_pstype  ]-value OPTIONAL ).

    rs_parameter-poowner = VALUE #( it_key_tab[ name = mc_parameter_poowner ]-value OPTIONAL ).

  ENDMETHOD.


  METHOD method_get_entityset.

    IF io_tech_request_context IS NOT BOUND.
      RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception.
    ENDIF.

    TRY.

        get_dashboard( )->method_parameters(
          EXPORTING
            is_parameter = get_method_parameter( it_key_tab )
          IMPORTING
            et_result    = et_entityset ).

      CATCH cx_sy_conversion_error
            cx_sy_arithmetic_error
            cx_sy_open_sql_db
            zcx_fi_das_error INTO DATA(lx_error).

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.


  METHOD openpotypeset_get_entityset.

    TRY.
        get_dashboard( )->over(
          EXPORTING
            is_request    = build_request( it_key_tab              = it_key_tab
                                           io_tech_request_context = io_tech_request_context )
          IMPORTING
            et_result     = et_entityset
            e_total_count = es_response_context-inlinecount ).

      CATCH cx_sy_conversion_error
            cx_sy_open_sql_db
            zcx_fi_das_error INTO DATA(lx_error).

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.


  METHOD thresholdset_get_entityset.

    TRY.
        get_dashboard( )->under(
          EXPORTING
            is_request    = build_request( it_key_tab              = it_key_tab
                                           io_tech_request_context = io_tech_request_context )
          IMPORTING
            et_result     = et_entityset
            e_total_count = es_response_context-inlinecount ).

      CATCH cx_sy_conversion_error
            cx_sy_open_sql_db
            zcx_fi_das_error INTO DATA(lx_error).

        RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
          EXPORTING
            previous = lx_error.

    ENDTRY.

  ENDMETHOD.
ENDCLASS.
