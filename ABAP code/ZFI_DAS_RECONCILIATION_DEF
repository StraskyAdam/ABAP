CLASS lcl_reconciliation DEFINITION FINAL.

  PUBLIC SECTION.

    METHODS run
      IMPORTING
        i_test_mode TYPE abap_bool DEFAULT abap_true
      RAISING
        zcx_fi_das_error.

  PRIVATE SECTION.

    CONSTANTS:
      mc_target          TYPE tabname VALUE 'ZFI_DAS_RECON',
      mc_asterisk        TYPE c LENGTH 1 VALUE '*',
      mc_first_day       TYPE c LENGTH 2 VALUE '01',
      mc_next_month      TYPE i VALUE 32,
      mc_amount_decimals TYPE i VALUE 2,
      mc_package_size    TYPE i VALUE 50000,

      mc_material_text   TYPE zfi_das_recon-pstype_text VALUE 'Material PO',
      mc_service_text    TYPE zfi_das_recon-pstype_text VALUE 'Services PO',
      mc_over_material   TYPE zfi_das_recon-po_dashboard_section VALUE 'Indirect Material',
      mc_over_service    TYPE zfi_das_recon-po_dashboard_section VALUE 'Indirect Services',
      mc_under_material  TYPE zfi_das_recon-po_dashboard_section VALUE 'Below Threshold PO Material',
      mc_under_service   TYPE zfi_das_recon-po_dashboard_section VALUE 'Below Threshold PO Service',
      mc_excl_material   TYPE zfi_das_recon-po_dashboard_section VALUE 'Exclusion Indirect Material',
      mc_excl_service    TYPE zfi_das_recon-po_dashboard_section VALUE 'Exclusion Indirect Service'.

    TYPES:
      tt_result TYPE STANDARD TABLE OF zfi_das_recon WITH EMPTY KEY,

      BEGIN OF ts_source,
        companycode             TYPE zfi_das_shared-companycode,
        poowner_email           TYPE zfi_das_recon-po_owner,
        ponumber                TYPE zfi_das_shared-ponumber,
        itemno                  TYPE zfi_das_shared-itemno,
        documentdate            TYPE zfi_das_shared-documentdate,
        polinedesc              TYPE zfi_das_recon-po_line_description,
        supplierid              TYPE zfi_das_shared-supplierid,
        suppliername            TYPE zfi_das_recon-supplier_name,
        wrkstrtdate             TYPE zfi_das_shared-wrkstrtdate,
        wrkenddate              TYPE zfi_das_shared-wrkenddate,
        cocdecurr               TYPE zfi_das_shared-cocdecurr,
        pocurrency              TYPE zfi_das_shared-pocurrency,
        orderquantity           TYPE zfi_das_over_under-orderquantity,
        povalue                 TYPE zfi_das_shared-povalue,
        invvalue                TYPE zfi_das_shared-invvalue,
        exchangerate_dec        TYPE zfi_das_shared-exchangerate_dec,
        totwrkcompamt           TYPE zfi_das_shared-totwrkcompamt,
        grvalue                 TYPE zfi_das_shared-grvalue,
        accrualmethod           TYPE zfi_das_shared-accrualmethod,
        po_preparer             TYPE zfi_das_recon-po_preparer,
        pstype                  TYPE zfi_das_shared-pstype,
        status                  TYPE zfi_das_shared-status,
        grvalue_usd             TYPE zfi_das_shared-grvalue_usd,
        straightlinemthd        TYPE zfi_das_shared-straightlinemthd,
        reviwed_by              TYPE zfi_das_recon-reviewed_by,
        changed_on              TYPE zfi_das_shared-changed_on,
        region                  TYPE zfi_das_shared-region,
        pocreatedat             TYPE zfi_das_shared-pocreatedat,
        invvalue_usd            TYPE zfi_das_shared-invvalue_usd,
        totwrkcompper           TYPE zfi_das_shared-totwrkcompper,
        povalue_usd             TYPE zfi_das_shared-povalue_usd,
        totwrkcompamt_usd       TYPE zfi_das_shared-totwrkcompamt_usd,
        epnumber                TYPE zfi_das_shared-epnumber,
        amountaccrued           TYPE zfi_das_over_under-amountaccrued,
        amountaccrued_usd       TYPE zfi_das_over_under-amountaccrued_usd,
        amountaccrued_cocdecurr TYPE zfi_das_over_under-amountaccrued_cocdecurr,
        ruletype                TYPE string,
        ruletypetext            TYPE string,
      END OF ts_source,

      tt_source TYPE STANDARD TABLE OF ts_source WITH EMPTY KEY,

      BEGIN OF ts_account,
        ponumber       TYPE ebeln,
        itemno         TYPE ebelp,
        glaccount      TYPE ekkn-sakto,
        costcenter     TYPE ekkn-kostl,
        manageunit     TYPE csks-zzrptun,
        internalorder  TYPE ekkn-aufnr,
        assetid        TYPE ekkn-anln1,
        profitcenter   TYPE ekkn-prctr,
        bbp_acc_no     TYPE ekkn-zekkn,
        distpercentage TYPE ekkn-vproz,
        quantity       TYPE ekkn-menge,
      END OF ts_account,

      tt_account TYPE SORTED TABLE OF ts_account
        WITH NON-UNIQUE KEY ponumber itemno bbp_acc_no.

    DATA:
      mr_dashboard       TYPE REF TO zif_fi_das_dashboard,
      m_used_replication TYPE abap_bool,
      m_posting_date     TYPE dats,
      m_inserted         TYPE int8.

    METHODS:
      get_posting_date
        RETURNING
          VALUE(r_date) TYPE dats
        RAISING
          zcx_fi_das_error,

      process_mode
        IMPORTING
          i_mode      TYPE zif_fi_das_dashboard=>t_mode
          i_pstype    TYPE zif_fi_das_dashboard=>t_pstype
          i_test_mode TYPE abap_bool
        RAISING
          zcx_fi_das_error
          cx_sy_conversion_error
          cx_sy_open_sql_db,

      get_source
        IMPORTING
          i_mode        TYPE zif_fi_das_dashboard=>t_mode
          i_pstype      TYPE zif_fi_das_dashboard=>t_pstype
          i_skip        TYPE i
        EXPORTING
          et_source     TYPE tt_source
          e_total_count TYPE int8
        RAISING
          zcx_fi_das_error
          cx_sy_conversion_error
          cx_sy_open_sql_db,

      get_accounts
        IMPORTING
          it_source          TYPE tt_source
        RETURNING
          VALUE(rt_accounts) TYPE tt_account,

      get_results
        IMPORTING
          it_source        TYPE tt_source
          i_mode           TYPE zif_fi_das_dashboard=>t_mode
        RETURNING
          VALUE(rt_result) TYPE tt_result
        RAISING
          zcx_fi_das_error,

      save
        IMPORTING
          it_result TYPE tt_result
        RAISING
          zcx_fi_das_error,

      append_row
        IMPORTING
          is_source       TYPE ts_source
          is_account      TYPE ts_account
          i_mode          TYPE zif_fi_das_dashboard=>t_mode
          i_account_count TYPE i
        CHANGING
          ct_result       TYPE tt_result
        RAISING
          zcx_fi_das_error,

      calculate_recon_accrued
        IMPORTING
          i_amount         TYPE zfi_das_over_under-amountaccrued
          i_distpercentage TYPE ekkn-vproz
          i_quantity       TYPE ekkn-menge
          i_account_count  TYPE i
        RETURNING
          VALUE(r_amount)  TYPE zfi_das_recon-amount_to_be_accrued_ccode,

      summary
        IMPORTING
          i_test_mode TYPE abap_bool.

ENDCLASS.

CLASS lcl_reconciliation IMPLEMENTATION.

  METHOD run.

    TRY.

        DELETE FROM ZFI_DAS_RECON.
      COMMIT WORK AND WAIT.

        zcl_fi_das_utility=>check_table_authority( mc_target ).

        mr_dashboard = NEW zcl_fi_das_dashboard( ).
        m_posting_date = get_posting_date( ).
        m_used_replication = zcl_fi_das_dashboard=>get_use_replication( ).

        process_mode( i_mode      = zif_fi_das_dashboard=>mc_over
                      i_pstype    = zif_fi_das_dashboard=>mc_pstype_service
                      i_test_mode = i_test_mode ).

        process_mode( i_mode      = zif_fi_das_dashboard=>mc_over
                      i_pstype    = zif_fi_das_dashboard=>mc_pstype_material
                      i_test_mode = i_test_mode ).

        process_mode( i_mode      = zif_fi_das_dashboard=>mc_under
                      i_pstype    = zif_fi_das_dashboard=>mc_pstype_service
                      i_test_mode = i_test_mode ).

        process_mode( i_mode      = zif_fi_das_dashboard=>mc_under
                      i_pstype    = zif_fi_das_dashboard=>mc_pstype_material
                      i_test_mode = i_test_mode ).

        process_mode( i_mode      = zif_fi_das_dashboard=>mc_exclude
                      i_pstype    = zif_fi_das_dashboard=>mc_pstype_all
                      i_test_mode = i_test_mode ).

        IF i_test_mode = abap_false.

          COMMIT WORK AND WAIT.

          IF sy-subrc <> 0.
            RAISE EXCEPTION TYPE zcx_fi_das_error
              MESSAGE e031(zfi_das) WITH mc_target.
          ENDIF.

        ENDIF.

      CATCH zcx_fi_das_error INTO DATA(lx_das_error).

        ROLLBACK WORK.
        RAISE EXCEPTION lx_das_error.

      CATCH cx_root INTO DATA(lx_unexpected_error).

        ROLLBACK WORK.

        RAISE EXCEPTION TYPE zcx_fi_das_error
          EXPORTING
            previous = lx_unexpected_error
            i_text   = lx_unexpected_error->get_text( ).

    ENDTRY.

    summary( i_test_mode ).

  ENDMETHOD.

  METHOD process_mode.

    DATA l_skip TYPE i.

    DO.

      get_source( EXPORTING i_mode        = i_mode
                            i_pstype      = i_pstype
                            i_skip        = l_skip
                  IMPORTING et_source     = DATA(lt_source)
                            e_total_count = DATA(l_total_count) ).

      DATA(lt_result) = get_results( it_source = lt_source
                                     i_mode    = i_mode ).

      " Duplicates can only come from one PO item, which is never split across packages.
      SORT lt_result BY table_line.
      DELETE ADJACENT DUPLICATES FROM lt_result COMPARING ALL FIELDS.

      IF i_test_mode = abap_true.
        m_inserted = m_inserted + lines( lt_result ).
      ELSE.
        save( lt_result ).
      ENDIF.

      FREE: lt_source, lt_result.

      l_skip = l_skip + mc_package_size.

      IF l_skip >= l_total_count.
        EXIT.
      ENDIF.

    ENDDO.

  ENDMETHOD.

  METHOD save.

    DATA(lt_result) = it_result.

    IF lt_result IS INITIAL.
      RETURN.
    ENDIF.

    LOOP AT lt_result ASSIGNING FIELD-SYMBOL(<fs_result>).
      <fs_result>-guuid = cl_system_uuid=>create_uuid_c32_static( ).
    ENDLOOP.

    INSERT zfi_das_recon FROM TABLE @lt_result.

    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE zcx_fi_das_error
        MESSAGE e030(zfi_das) WITH mc_target.
    ENDIF.

    m_inserted = m_inserted + sy-dbcnt.

  ENDMETHOD.

  METHOD get_posting_date.

    GET TIME STAMP FIELD DATA(l_timestamp).

    CONVERT TIME STAMP l_timestamp TIME ZONE zcl_fi_das_utility=>mc_timezone_utc
      INTO DATE DATA(l_date).

    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE zcx_fi_das_error
        MESSAGE e000(zfi_das) WITH 'Cannot determine reconciliation date'.
    ENDIF.

    DATA(l_first_of_month) = CONV d( l_date(6) && mc_first_day ).
    DATA(l_next_month) = CONV d( l_first_of_month + mc_next_month ).

    r_date = CONV d( l_next_month(6) && mc_first_day ) - 1.

  ENDMETHOD.

  METHOD get_source.

    CLEAR: et_source, e_total_count.

    DATA(ls_request) = VALUE zif_fi_das_dashboard=>ts_request(
      parameter = VALUE #( email   = mc_asterisk
                           poowner = abap_false
                           pstype  = i_pstype )
      paging    = VALUE #( skip            = i_skip
                           top             = mc_package_size
                           top_requested   = abap_true
                           count_requested = abap_true )
      options   = VALUE #( without_formatting = abap_true ) ).

    CASE i_mode.

      WHEN zif_fi_das_dashboard=>mc_over.

        mr_dashboard->over( EXPORTING is_request    = ls_request
                            IMPORTING et_result     = DATA(lt_over)
                                      e_total_count = DATA(l_total_count) ).

        et_source = CORRESPONDING #( lt_over ).

      WHEN zif_fi_das_dashboard=>mc_under.

        mr_dashboard->under( EXPORTING is_request    = ls_request
                             IMPORTING et_result     = DATA(lt_under)
                                       e_total_count = l_total_count ).

        et_source = CORRESPONDING #( lt_under ).

      WHEN zif_fi_das_dashboard=>mc_exclude.

        mr_dashboard->exclude( EXPORTING is_request    = ls_request
                               IMPORTING et_result     = DATA(lt_exclude)
                                         e_total_count = l_total_count ).

        et_source = CORRESPONDING #( lt_exclude ).

      WHEN OTHERS.

        RAISE EXCEPTION TYPE zcx_fi_das_error MESSAGE e005(zfi_das).

    ENDCASE.

    e_total_count = l_total_count.

  ENDMETHOD.

  METHOD get_accounts.

    IF it_source IS INITIAL.
      RETURN.
    ENDIF.

    SELECT ekkn~ebeln   AS ponumber,
           ekkn~ebelp   AS itemno,
           ekkn~sakto   AS glaccount,
           ekkn~kostl   AS costcenter,
           csks~zzrptun AS manageunit,
           ekkn~aufnr   AS internalorder,
           ekkn~anln1   AS assetid,
           ekkn~prctr   AS profitcenter,
           ekkn~zekkn   AS bbp_acc_no,
           ekkn~vproz   AS distpercentage,
           ekkn~menge   AS quantity
      FROM zi_fi_das_ekkn( p_use_replication = @m_used_replication ) AS ekkn
      LEFT OUTER JOIN zi_fi_das_csks( p_use_replication = @m_used_replication ) AS csks
        ON  csks~kokrs = ekkn~kokrs
        AND csks~kostl = ekkn~kostl
        AND csks~datbi >= @sy-datum
      FOR ALL ENTRIES IN @it_source
      WHERE ekkn~ebeln = @it_source-ponumber
        AND ekkn~ebelp = @it_source-itemno
      INTO TABLE @rt_accounts.

  ENDMETHOD.

  METHOD get_results.

    DATA(lt_accounts) = get_accounts( it_source ).

    LOOP AT it_source ASSIGNING FIELD-SYMBOL(<fs_source>).

      DATA(l_account_count) = 0.

      LOOP AT lt_accounts INTO DATA(ls_account)
        WHERE ponumber = <fs_source>-ponumber
          AND itemno   = <fs_source>-itemno
        GROUP BY ls_account-bbp_acc_no
        WITHOUT MEMBERS
        INTO DATA(l_bbp_acc_no).

        l_account_count = l_account_count + 1.

      ENDLOOP.

      IF l_account_count = 0.

        append_row( EXPORTING is_source       = <fs_source>
                              is_account      = VALUE #( )
                              i_mode          = i_mode
                              i_account_count = l_account_count
                    CHANGING  ct_result       = rt_result ).

        CONTINUE.

      ENDIF.

      LOOP AT lt_accounts ASSIGNING FIELD-SYMBOL(<fs_account>)
        WHERE ponumber = <fs_source>-ponumber
          AND itemno   = <fs_source>-itemno.

        append_row( EXPORTING is_source       = <fs_source>
                              is_account      = <fs_account>
                              i_mode          = i_mode
                              i_account_count = l_account_count
                    CHANGING  ct_result       = rt_result ).

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.

   METHOD append_row.

    DATA:
      l_changed_on  TYPE dats,
      lt_rule_types TYPE STANDARD TABLE OF string WITH EMPTY KEY,
      lt_rule_texts TYPE STANDARD TABLE OF string WITH EMPTY KEY.

    IF is_source-changed_on IS NOT INITIAL.

      CONVERT TIME STAMP is_source-changed_on
        TIME ZONE zcl_fi_das_utility=>mc_timezone_utc
        INTO DATE l_changed_on.

      IF sy-subrc <> 0.
        RAISE EXCEPTION TYPE zcx_fi_das_error
          MESSAGE e000(zfi_das)
          WITH 'Cannot convert reconciliation changed-on date'.
      ENDIF.

    ENDIF.

    DATA(l_service) = xsdbool(
      is_source-pstype = zif_fi_das_dashboard=>mc_pstype_service ).

    DATA(ls_result) = VALUE zfi_das_recon(
      mandt                        = sy-mandt
      company_code                 = is_source-companycode
      cost_center                  = zcl_fi_das_utility=>alpha_output( CONV string( is_account-costcenter ) )
      gl_account                   = zcl_fi_das_utility=>alpha_output( CONV string( is_account-glaccount ) )
      po_owner                     = is_source-poowner_email
      posting_date                 = m_posting_date
      split_accounting_number      = is_account-bbp_acc_no
      po_number                    = is_source-ponumber
      po_lineitem                  = is_source-itemno
      internal_order               = zcl_fi_das_utility=>alpha_output( CONV string( is_account-internalorder ) )
      purchase_order_date          = is_source-documentdate
      po_line_description          = is_source-polinedesc
      supplier_code                = is_source-supplierid
      supplier_name                = is_source-suppliername
      sap_vendor_number            = is_source-supplierid
      asset_id                     = zcl_fi_das_utility=>alpha_output( CONV string( is_account-assetid ) )
      profit_center                = is_account-profitcenter
      service_start_date           = is_source-wrkstrtdate
      service_end_date             = is_source-wrkenddate
      companycode_currency         = is_source-cocdecurr
      document_currency            = is_source-pocurrency
      order_quantity               = is_source-orderquantity
      net_price                    = is_source-povalue
      invoice_amount               = is_source-invvalue
      exchange_rate                = is_source-exchangerate_dec
      po_value                     = is_source-povalue
      services_completed_amount    = is_source-totwrkcompamt
      goods_receipt_to_date        = is_source-grvalue
      accrual_method               = is_source-accrualmethod
      po_preparer                  = is_source-po_preparer
      pstype_text                  = COND #(
                                       WHEN l_service = abap_true
                                       THEN mc_service_text
                                       ELSE mc_material_text )
      status                       = is_source-status
      goods_receipt_to_date_usd    = is_source-grvalue_usd
      management_unit              = is_account-manageunit
      straight_line_mthd           = is_source-straightlinemthd
      reviewed_by                  = is_source-reviwed_by
      changed_on                   = l_changed_on
      region                       = is_source-region
      pocreatedat                  = is_source-pocreatedat
      invoice_amount_to_date_usd   = is_source-invvalue_usd
      percentage_service_completed = is_source-totwrkcompper
      povalue_usd                  = is_source-povalue_usd
      service_completed_amount_usd = is_source-totwrkcompamt_usd
      pr_number                    = is_source-epnumber ).

    IF i_mode = zif_fi_das_dashboard=>mc_under OR
       i_mode = zif_fi_das_dashboard=>mc_exclude.

      ls_result-accrual_method =
        zcl_fi_das_utility=>get_accrual_method_text(
          is_source-accrualmethod ).

    ENDIF.

    IF i_mode = zif_fi_das_dashboard=>mc_under.

      ls_result-straight_line_mthd =
        zcl_fi_das_utility=>bool_to_text(
          is_source-straightlinemthd ).

    ENDIF.

    ls_result-po_dashboard_section = SWITCH #(
      i_mode
      WHEN zif_fi_das_dashboard=>mc_over
        THEN COND #(
          WHEN l_service = abap_true
          THEN mc_over_service
          ELSE mc_over_material )
      WHEN zif_fi_das_dashboard=>mc_under
        THEN COND #(
          WHEN l_service = abap_true
          THEN mc_under_service
          ELSE mc_under_material )
      WHEN zif_fi_das_dashboard=>mc_exclude
        THEN COND #(
          WHEN l_service = abap_true
          THEN mc_excl_service
          ELSE mc_excl_material ) ).

    IF i_mode = zif_fi_das_dashboard=>mc_exclude.

      CLEAR: ls_result-order_quantity,
             ls_result-exchange_rate,
             ls_result-reviewed_by.

      SPLIT is_source-ruletype
        AT zcl_fi_das_utility=>mc_semicolon
        INTO TABLE lt_rule_types.

      SPLIT is_source-ruletypetext
        AT zcl_fi_das_utility=>mc_semicolon
        INTO TABLE lt_rule_texts.

      IF is_source-ruletype IS INITIAL OR
         lines( lt_rule_types ) <> lines( lt_rule_texts ).

        RAISE EXCEPTION TYPE zcx_fi_das_error
          MESSAGE e000(zfi_das)
          WITH 'Invalid reconciliation exclusion rules'
               is_source-ponumber
               is_source-itemno.

      ENDIF.

      LOOP AT lt_rule_types INTO DATA(l_rule_type).

        DATA(l_rule_index) = sy-tabix.
        DATA(l_rule_text) = lt_rule_texts[ l_rule_index ].

        CONDENSE: l_rule_type, l_rule_text.

        IF l_rule_type IS INITIAL OR l_rule_text IS INITIAL.

          RAISE EXCEPTION TYPE zcx_fi_das_error
            MESSAGE e000(zfi_das)
            WITH 'Empty reconciliation exclusion rule'
                 is_source-ponumber
                 is_source-itemno.

        ENDIF.

        ls_result-rule_type = l_rule_type.
        ls_result-rule_type_text = l_rule_text.

        APPEND ls_result TO ct_result.

      ENDLOOP.

      RETURN.

    ENDIF.

    ls_result-amount_accrued = is_source-amountaccrued.
    ls_result-amount_accrued_usd = is_source-amountaccrued_usd.

    ls_result-amount_to_be_accrued_ccode = calculate_recon_accrued(
      i_amount         = is_source-amountaccrued
      i_distpercentage = is_account-distpercentage
      i_quantity       = is_account-quantity
      i_account_count  = i_account_count ).

    IF is_source-amountaccrued_cocdecurr > 0.
      ls_result-amount_to_be_accrued_doc =
        is_source-amountaccrued_cocdecurr.
    ENDIF.

    APPEND ls_result TO ct_result.

  ENDMETHOD.

  METHOD calculate_recon_accrued.

    IF i_amount <= 0.
      RETURN.
    ENDIF.

    DATA(l_amount) = CONV decfloat34( i_amount ).

    IF i_distpercentage > 0 AND i_quantity >= 0.

      l_amount = l_amount * i_distpercentage / 100.

    ELSEIF i_distpercentage = 0 AND i_quantity >= 0.

      IF i_quantity < 1 AND i_account_count > 1.
        l_amount = l_amount * i_quantity.
      ELSEIF i_quantity < 1 AND i_account_count <> 1.
        RETURN.
      ENDIF.

    ELSE.
      RETURN.
    ENDIF.

    r_amount = zcl_fi_das_utility=>truncate_decimal(
      i_value    = l_amount
      i_decimals = mc_amount_decimals ).

  ENDMETHOD.

  METHOD summary.

    WRITE:
      / COND string( WHEN i_test_mode = abap_true THEN 'Test run; no rows inserted'
                     ELSE 'Reconciliation snapshot completed' ),
      / |Posting date: { m_posting_date DATE = USER }|,
      / |Rows: { m_inserted }|.

  ENDMETHOD.

ENDCLASS.
