REPORT zfi_das_replication.

INCLUDE zfi_das_replication_def.

PARAMETERS: p_table TYPE tabname OBLIGATORY,
            p_del   AS CHECKBOX DEFAULT abap_true.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_table.
  lcl_replication=>value_help( ).

AT SELECTION-SCREEN.
  TRY.
      lcl_replication=>validate( p_table ).

    CATCH zcx_fi_das_error INTO DATA(lx_validation).

      MESSAGE lx_validation TYPE zcl_fi_das_utility=>mc_message_success DISPLAY LIKE zcl_fi_das_utility=>mc_message_error.

  ENDTRY.

START-OF-SELECTION.

  TRY.
      NEW lcl_replication( )->run( i_table  = p_table
                                   i_delete = p_del ).

    CATCH zcx_fi_das_error INTO DATA(lx_error).

      MESSAGE lx_error->get_text( ) TYPE zcl_fi_das_utility=>mc_message_success DISPLAY LIKE zcl_fi_das_utility=>mc_message_error.

  ENDTRY.
