FUNCTION z_fi_das_notify_po_owners.
*"----------------------------------------------------------------------
*" Remote-enabled; all parameters passed by value, type STRING.
*" IMPORTING VALUE(I_USER) TYPE STRING VALUE(I_ITEMS) TYPE STRING
*" EXPORTING VALUE(E_MESSAGE) TYPE STRING VALUE(E_ERROR) TYPE STRING
*"----------------------------------------------------------------------
  DATA lt_items TYPE zif_fi_das_dashboard=>tt_notify_item.

  CLEAR: e_message, e_error.
  TRY.
      CALL TRANSFORMATION id SOURCE XML i_items RESULT items = lt_items.
      e_message = NEW zcl_fi_das_notify( )->execute(
        i_user = i_user it_items = lt_items ).
    CATCH zcx_fi_das_error
          cx_sy_open_sql_db
          cx_transformation_error INTO DATA(lx_error).
      ROLLBACK WORK.
      e_error = lx_error->get_text( ).
  ENDTRY.
ENDFUNCTION.
